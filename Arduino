// --- Pin Configurations ---
const int MQ135_PIN = A0;    // MQ-135 Analog Output
const int MQ2_PIN = A1;      // MQ-2 Analog Output
const int BUZZER_PIN = 8;    // Raw Piezo Disc (Positive Center)
const int YELLOW_LED = 11;   // Warning Indicator
const int RED_LED = 12;      // Critical Alarm Indicator

// --- Threshold Settings (Adjust based on calibration) ---
const int MQ135_THRESHOLD = 400; 
const int MQ2_THRESHOLD = 350;   

void setup() {
  // Start serial communication at 9600 baud for Python integration
  Serial.begin(9600); 
  
  // Initialize digital output pins
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
}

void loop() {
  // 1. Read raw analog values from the sensors (0 to 1023)
  int mq135_val = analogRead(MQ135_PIN); 
  int mq2_val = analogRead(MQ2_PIN);   
  
  // Flag to track if the hardware is already in a critical state
  bool hardware_danger = false;

  // 2. Simple threshold alert logic (Hardware Failsafe)
  if (mq2_val > MQ2_THRESHOLD) {
    // Critical Hazard: Flash Red LED and sound a 2.5kHz tone
    digitalWrite(RED_LED, HIGH);
    digitalWrite(YELLOW_LED, LOW);
    tone(BUZZER_PIN, 2500); 
    hardware_danger = true;
  } 
  else if (mq135_val > MQ135_THRESHOLD) {
    // Moderate Hazard: Turn on Yellow LED, turn off buzzer
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, HIGH);
    noTone(BUZZER_PIN);
  } 
  else {
    // All Clear: Everything off
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    noTone(BUZZER_PIN);
  }

  // 3. Listen for Python AI Overrides (Decision-Level Fusion)
  if (Serial.available() > 0) {
    char cmd = Serial.read();
    
    // Python sends '2' if YOLO detects fire OR MLP detects critical gas
    if (cmd == '2') {
      digitalWrite(RED_LED, HIGH);
      tone(BUZZER_PIN, 2200); // Slightly different tone for AI trigger
    } 
    // Python sends '1' if YOLO detects a human (Tracking mode)
    else if (cmd == '1' && !hardware_danger) {
      digitalWrite(YELLOW_LED, HIGH); 
    }
  }

  // 4. Stream data to the Python pipeline: "MQ135,MQ2"
  Serial.print(mq135_val);
  Serial.print(",");
  Serial.println(mq2_val);

  // 5. Small delay to stabilize readings and keep the Python UI responsive
  delay(200); 
}
